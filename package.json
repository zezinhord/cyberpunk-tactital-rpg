{
  "name": "cyberpunk-tactical-rpg",
  "private": true,
  "version": "0.6.9-rc.2",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "generate:characters": "python tools/generate_character_sprites.py",
    "prebuild": "npm run generate:characters",
    "predev": "npm run generate:characters",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "cap:sync": "cap sync android",
    "cap:open": "cap open android",
    "android:add": "cap add android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "phaser": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "packageManager": "npm@10.9.2"
}
